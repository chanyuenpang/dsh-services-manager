{
  "name": "dsh-services-manager",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "DSH 0.2 Desktop/Web 的服务管理分区：查看与控制宿主后台服务，并按运行时安全重启当前 DSH。",
  "keywords": ["dsh", "deepseek-harness", "cordis-plugin", "services"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/chanyuenpang/dsh-services-manager.git" },
  "homepage": "https://github.com/chanyuenpang/dsh-services-manager#readme",
  "bugs": { "url": "https://github.com/chanyuenpang/dsh-services-manager/issues" },
  "main": "src/index.mjs",
  "bin": { "dsh-services": "src/cli.mjs" },
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/",
    "lib/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "verify-host": "node scripts/verify-host.mjs",
    "verify-cli-package": "node scripts/verify-cli-package.mjs"
  }
}
